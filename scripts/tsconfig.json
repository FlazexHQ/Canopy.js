{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.server.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": ["."]
}
