{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.web.json",
  "compilerOptions": {
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "../../node_modules/.cache/test-types/svelte",
    "tsBuildInfoFile": "../../node_modules/.cache/test-types/svelte/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["."],
  "exclude": ["registered"],
  "references": [{ "path": "../../src/tsconfig.web.json" }, { "path": "../support" }]
}
