              "typeName": {
                "$ref": "#/$defs/textSetting"
              },
              "relations": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "to": {
                      "$ref": "#/$defs/textSetting"
                    },
                    "local": {
                      "$ref": "#/$defs/textSetting"
                    },
                    "foreign": {
                      "$ref": "#/$defs/textSetting"
                    },
                    "many": {
                      "$ref": "#/$defs/booleanSetting"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "search": {
                "$ref": "#/$defs/booleanSetting"
              }
            },
            "additionalProperties": false
