              ]
            },
            {
              "type": "object",
              "properties": {
                "source": {
                  "anyOf": [
                    {
                      "const": "database"
                    },
                    {
                      "$ref": "#/$defs/env"
                    }
                  ]
                },
                "watch": {
                  "$ref": "#/$defs/booleanSetting"
                }
              },
              "additionalProperties": false,
              "required": [
                "source"
              ]
            }
          ]
        },
        "rest": {
          "anyOf": [
            {
