                "secret": {
                  "$ref": "#/$defs/textSetting"
                },
                "appName": {
                  "$ref": "#/$defs/textSetting"
                },
                "accessTokenTtl": {
                  "$ref": "#/$defs/durationSetting"
                },
                "algorithm": {
                  "anyOf": [
                    {
                      "enum": [
                        "EdDSA",
                        "ES256"
                      ]
                    },
                    {
                      "$ref": "#/$defs/env"
                    }
                  ]
                },
                "keyRotation": {
                  "type": "object",
                  "properties": {
                    "interval": {
                      "$ref": "#/$defs/durationSetting"
                    },
                    "grace": {
                      "$ref": "#/$defs/durationSetting"
                    }
