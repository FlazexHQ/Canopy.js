                "domain": {
                  "$ref": "#/$defs/textSetting"
                },
                "audience": {
                  "$ref": "#/$defs/textSetting"
                },
                "rolesClaim": {
                  "$ref": "#/$defs/textSetting"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "clerk"
                },
                "frontendApi": {
                  "$ref": "#/$defs/textSetting"
                },
                "audience": {
                  "$ref": "#/$defs/textSetting"
                },
                "rolesClaim": {
                  "$ref": "#/$defs/textSetting"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "firebase"
                },
                "projectId": {
                  "$ref": "#/$defs/textSetting"
                },
                "rolesClaim": {
                  "$ref": "#/$defs/textSetting"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "supabase"
                },
                "projectRef": {
                  "$ref": "#/$defs/textSetting"
                },
                "rolesClaim": {
                  "$ref": "#/$defs/textSetting"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind"
              ]
            }
          ]
