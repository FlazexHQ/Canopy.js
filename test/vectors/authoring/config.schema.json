                    "bucket": {
                      "$ref": "#/$defs/textSetting"
                    },
                    "accessKeyId": {
                      "$ref": "#/$defs/textSetting"
                    },
                    "secretAccessKey": {
                      "$ref": "#/$defs/textSetting"
                    },
                    "sessionToken": {
                      "$ref": "#/$defs/textSetting"
                    },
                    "forcePathStyle": {
                      "$ref": "#/$defs/booleanSetting"
                    },
                    "prefix": {
                      "$ref": "#/$defs/textSetting"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ]
