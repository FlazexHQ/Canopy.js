                "jwksUrl": {
                  "$ref": "#/$defs/absoluteUrlSetting"
                },
                "jwks": {
                  "$ref": "#/$defs/raw"
                },
                "issuer": {
                  "$ref": "#/$defs/textSetting"
                },
                "audience": {
                  "$ref": "#/$defs/textSetting"
                },
                "algorithms": {
                  "$ref": "#/$defs/stringListSetting"
                },
                "rolesClaim": {
                  "$ref": "#/$defs/textSetting"
                },
                "allowServiceRoleFromJwt": {
                  "$ref": "#/$defs/booleanSetting"
                },
                "clockToleranceSeconds": {
                  "$ref": "#/$defs/safeIntegerSetting"
