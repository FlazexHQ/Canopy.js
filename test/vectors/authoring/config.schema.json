            {
              "type": "object",
              "properties": {
                "defaultLimit": {
                  "$ref": "#/$defs/safeIntegerSetting"
                },
                "maxLimit": {
                  "$ref": "#/$defs/safeIntegerSetting"
                },
                "maxBodyBytes": {
                  "$ref": "#/$defs/safeIntegerSetting"
                },
                "mutationTtl": {
                  "$ref": "#/$defs/durationSetting"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "realtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/boolean"
            },
            {
              "type": "object",
              "properties": {
                "fullDocument": {
                  "anyOf": [
                    {
                      "enum": [
                        "auto",
                        "updateLookup",
                        "images"
                      ]
                    },
                    {
                      "$ref": "#/$defs/env"
                    }
                  ]
                },
                "transports": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "enum": [
                          "websocket",
                          "sse",
                          "long-poll"
                        ]
                      }
                    },
                    {
                      "$ref": "#/$defs/env"
                    }
                  ]
                },
                "resumeWindow": {
                  "$ref": "#/$defs/durationSetting"
                },
                "checkpoints": {
                  "anyOf": [
                    {
                      "enum": [
                        "meta",
                        "off"
                      ]
                    },
                    {
                      "$ref": "#/$defs/env"
                    }
                  ]
                },
                "drainWindow": {
                  "$ref": "#/$defs/durationSetting"
                },
                "echoTimeout": {
                  "$ref": "#/$defs/durationSetting"
                },
                "server": {
                  "anyOf": [
                    {
                      "enum": [
                        "ts",
                        "gateway",
                        "auto"
                      ]
                    },
                    {
                      "$ref": "#/$defs/env"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "graphql": {
          "anyOf": [
            {
              "$ref": "#/$defs/boolean"
