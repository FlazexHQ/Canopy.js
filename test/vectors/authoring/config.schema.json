        "keys": {
          "type": "object",
          "properties": {
            "publishable": {
              "$ref": "#/$defs/stringListSetting"
            },
            "secret": {
              "$ref": "#/$defs/stringListSetting"
            }
          },
          "additionalProperties": false
        },
        "policies": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "dir": {
                  "$ref": "#/$defs/textSetting"
                },
                "watch": {
                  "$ref": "#/$defs/booleanSetting"
                }
              },
              "additionalProperties": false,
              "required": [
