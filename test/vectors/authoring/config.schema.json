                    {
                      "$ref": "#/$defs/env"
                    }
                  ]
                },
                "persisted": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "$ref": "#/$defs/textSetting"
                    },
                    "only": {
                      "$ref": "#/$defs/booleanSetting"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "rateLimits": {
          "anyOf": [
            {
              "$ref": "#/$defs/boolean"
