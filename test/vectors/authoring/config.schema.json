                            "kind": {
                              "const": "smtp"
                            },
                            "host": {
                              "$ref": "#/$defs/textSetting"
                            },
                            "port": {
                              "$ref": "#/$defs/safeIntegerSetting"
                            },
                            "secure": {
                              "$ref": "#/$defs/booleanSetting"
                            },
                            "requireTls": {
                              "$ref": "#/$defs/booleanSetting"
                            },
                            "user": {
                              "$ref": "#/$defs/textSetting"
                            },
                            "pass": {
                              "$ref": "#/$defs/textSetting"
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "kind"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "resend"
                            },
                            "apiKey": {
                              "$ref": "#/$defs/textSetting"
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "kind"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "postmark"
                            },
                            "serverToken": {
                              "$ref": "#/$defs/textSetting"
                            },
                            "messageStream": {
                              "$ref": "#/$defs/textSetting"
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "kind"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "ses"
                            },
                            "region": {
                              "$ref": "#/$defs/textSetting"
                            },
                            "accessKeyId": {
                              "$ref": "#/$defs/textSetting"
                            },
                            "secretAccessKey": {
                              "$ref": "#/$defs/textSetting"
                            },
                            "sessionToken": {
                              "$ref": "#/$defs/textSetting"
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "kind"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "log"
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "kind"
