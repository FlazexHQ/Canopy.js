                      "$ref": "#/$defs/textSetting"
                    },
                    "secretAccessKey": {
                      "$ref": "#/$defs/textSetting"
                    },
                    "jurisdiction": {
                      "$ref": "#/$defs/textSetting"
                    },
                    "prefix": {
                      "$ref": "#/$defs/textSetting"
