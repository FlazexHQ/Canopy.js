                    },
                    "window": {
                      "$ref": "#/$defs/durationSetting"
                    }
                  },
                  "additionalProperties": false
                },
                "session": {
                  "type": "object",
                  "properties": {
                    "expiresIn": {
                      "$ref": "#/$defs/durationSetting"
                    },
                    "updateAge": {
                      "$ref": "#/$defs/durationSetting"
