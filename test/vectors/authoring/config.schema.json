                      "additionalProperties": false
                    }
                  ]
                },
                "magicLink": {
                  "$ref": "#/$defs/booleanSetting"
                },
                "emailOtp": {
                  "$ref": "#/$defs/booleanSetting"
                },
                "anonymous": {
                  "$ref": "#/$defs/booleanSetting"
                },
                "twoFactor": {
                  "$ref": "#/$defs/booleanSetting"
