            {
              "type": "object",
              "properties": {
                "enabled": {
                  "$ref": "#/$defs/booleanSetting"
                },
                "requests": {
                  "type": "object",
                  "properties": {
                    "perSecond": {
                      "$ref": "#/$defs/safeIntegerSetting"
                    },
                    "burst": {
                      "$ref": "#/$defs/safeIntegerSetting"
                    }
                  },
                  "additionalProperties": false
                },
                "messages": {
                  "type": "object",
                  "properties": {
                    "perSecond": {
                      "$ref": "#/$defs/safeIntegerSetting"
