            {
              "type": "object",
              "properties": {
                "maxDepth": {
                  "$ref": "#/$defs/safeIntegerSetting"
                },
                "maxComplexity": {
                  "$ref": "#/$defs/safeIntegerSetting"
                },
                "maxAliases": {
                  "$ref": "#/$defs/safeIntegerSetting"
