                    "burst": {
                      "$ref": "#/$defs/safeIntegerSetting"
                    }
                  },
                  "additionalProperties": false
                },
                "anonymousConnectionsPerAddress": {
                  "$ref": "#/$defs/safeIntegerSetting"
