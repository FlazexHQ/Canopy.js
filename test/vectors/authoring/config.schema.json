                "passkeys": {
                  "$ref": "#/$defs/booleanSetting"
                },
                "providers": {
                  "type": "object",
                  "properties": {
                    "google": {
                      "type": "object",
                      "properties": {
                        "clientId": {
                          "$ref": "#/$defs/textSetting"
                        },
                        "clientSecret": {
                          "$ref": "#/$defs/textSetting"
                        }
                      },
                      "additionalProperties": false
                    },
                    "github": {
                      "type": "object",
                      "properties": {
                        "clientId": {
                          "$ref": "#/$defs/textSetting"
                        },
                        "clientSecret": {
                          "$ref": "#/$defs/textSetting"
                        }
                      },
                      "additionalProperties": false
                    },
                    "apple": {
                      "type": "object",
                      "properties": {
                        "clientId": {
                          "$ref": "#/$defs/textSetting"
                        },
                        "clientSecret": {
                          "$ref": "#/$defs/textSetting"
                        }
                      },
                      "additionalProperties": false
                    },
                    "microsoft": {
                      "type": "object",
                      "properties": {
                        "clientId": {
                          "$ref": "#/$defs/textSetting"
                        },
                        "clientSecret": {
                          "$ref": "#/$defs/textSetting"
                        },
                        "tenantId": {
                          "$ref": "#/$defs/textSetting"
                        }
                      },
                      "additionalProperties": false
                    },
                    "discord": {
                      "type": "object",
                      "properties": {
                        "clientId": {
                          "$ref": "#/$defs/textSetting"
                        },
                        "clientSecret": {
                          "$ref": "#/$defs/textSetting"
                        }
                      },
                      "additionalProperties": false
