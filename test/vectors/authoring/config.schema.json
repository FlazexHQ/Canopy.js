            },
            "metaDatabase": {
              "$ref": "#/$defs/textSetting"
            },
            "authDatabase": {
              "$ref": "#/$defs/textSetting"
            }
          },
          "additionalProperties": false
        },
        "environment": {
          "anyOf": [
            {
              "enum": [
                "development",
                "production"
              ]
            },
            {
              "$ref": "#/$defs/env"
            }
          ]
        },
        "publicUrl": {
          "$ref": "#/$defs/absoluteUrlSetting"
        },
        "masterKey": {
          "$ref": "#/$defs/textSetting"
        },
        "previousMasterKeys": {
          "$ref": "#/$defs/stringListSetting"
