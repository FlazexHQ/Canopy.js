{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.server.json",
  "compilerOptions": {
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "../../node_modules/.cache/test-types/client",
    "tsBuildInfoFile": "../../node_modules/.cache/test-types/client/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["."],
  "exclude": ["registered"],
  "references": [{ "path": "../../src" }]
}
