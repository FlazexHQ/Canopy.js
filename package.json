{
  "name": "canopy.js",
  "version": "0.0.0",
  "description": "The TypeScript library for Canopy: the realtime client, React, Vue, Svelte, Solid and TanStack DB bindings, devtools, and the policy, schema and config DSLs, in one package.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "canopy-stack": "./dist/cli/bin.js"
  },
  "workspaces": [
    "examples/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "canopy-js-source": "./src/client/index.ts",
      "default": "./dist/client/index.js"
    },
    "./auth": {
      "types": "./dist/client/auth.d.ts",
      "canopy-js-source": "./src/client/auth.ts",
      "default": "./dist/client/auth.js"
    },
    "./fallback": {
      "types": "./dist/client/fallback.d.ts",
      "canopy-js-source": "./src/client/fallback.ts",
      "default": "./dist/client/fallback.js"
    },
    "./leader-tab": {
      "types": "./dist/client/leader-tab.d.ts",
      "canopy-js-source": "./src/client/leader-tab.ts",
      "default": "./dist/client/leader-tab.js"
    },
    "./persist": {
      "types": "./dist/client/persist.d.ts",
      "canopy-js-source": "./src/client/persist.ts",
      "default": "./dist/client/persist.js"
    },
    "./react-native": {
      "types": "./dist/client/react-native.d.ts",
      "canopy-js-source": "./src/client/react-native.ts",
      "default": "./dist/client/react-native.js"
    },
    "./rest": {
      "types": "./dist/client/rest/index.d.ts",
      "canopy-js-source": "./src/client/rest/index.ts",
      "default": "./dist/client/rest/index.js"
    },
    "./rest-polling": {
      "types": "./dist/client/rest-polling.d.ts",
      "canopy-js-source": "./src/client/rest-polling.ts",
      "default": "./dist/client/rest-polling.js"
    },
    "./server": {
      "types": "./dist/client/server.d.ts",
      "canopy-js-source": "./src/client/server.ts",
      "default": "./dist/client/server.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "canopy-js-source": "./src/react/index.tsx",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "canopy-js-source": "./src/vue/index.ts",
      "default": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "canopy-js-source": "./src/svelte/index.ts",
      "default": "./dist/svelte/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "canopy-js-source": "./src/solid/index.ts",
      "default": "./dist/solid/index.js"
    },
    "./tanstack-db": {
      "types": "./dist/tanstack-db/index.d.ts",
      "canopy-js-source": "./src/tanstack-db/index.ts",
      "default": "./dist/tanstack-db/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "canopy-js-source": "./src/devtools/index.ts",
      "default": "./dist/devtools/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "canopy-js-source": "./src/policy/index.ts",
      "default": "./dist/policy/index.js"
    },
    "./policy/testing": {
      "types": "./dist/policy/testing.d.ts",
      "canopy-js-source": "./src/policy/testing.ts",
      "default": "./dist/policy/testing.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "canopy-js-source": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "canopy-js-source": "./src/config/index.ts",
      "default": "./dist/config/index.js"
    },
    "./protocol": {
      "types": "./dist/core/protocol/index.d.ts",
      "canopy-js-source": "./src/core/protocol/index.ts",
      "default": "./dist/core/protocol/index.js"
    },
    "./emit": {
      "types": "./dist/emit/index.d.ts",
      "canopy-js-source": "./src/emit/index.ts",
      "default": "./dist/emit/index.js"
    },
    "./emit/cli": {
      "types": "./dist/emit/cli.d.ts",
      "canopy-js-source": "./src/emit/cli.ts",
      "default": "./dist/emit/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "templates/cli",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b && bun scripts/sync-wasm.ts --dist",
    "typecheck": "tsc -b && tsc -p scripts",
    "clean": "tsc -b --clean",
    "lint": "biome lint .",
    "format": "bun fmt",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sync:wasm": "bun scripts/sync-wasm.ts",
    "check:core-layout": "bun scripts/check-core-layout.ts && bun scripts/sync-wasm.ts --check --manifest-only",
    "check:wasm": "bun scripts/sync-wasm.ts --check",
    "check": "bun run lint && bun run format:check && bun run check:core-layout && bun run check:wasm && bun run typecheck && bun run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "format:check": "bun fmt --check"
  },
  "peerDependencies": {
    "@tanstack/db": "^1.0.0-rc.1",
    "react": "^19.0.0",
    "solid-js": "^1.8.0",
    "svelte": "^5.7.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/db": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tanstack/db": "1.0.0-rc.1.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "fake-indexeddb": "6.2.7",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "solid-js": "1.9.18",
    "svelte": "5.57.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44"
  }
}
